{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nanaichi",
  "main": "./src/server/index.ts",
  "compatibility_date": "2026-10-01",
  // Better Auth は AsyncLocalStorage を使うため nodejs_compat が必要
  // https://better-auth.com/docs/integrations/hono#cloudflare-workers
  "compatibility_flags": ["nodejs_compat"],
  // 本番の正の URL（ADR 0021）。workers.dev へのリクエストは Worker が nanaichi.app へ転送する
  "routes": [{ "pattern": "nanaichi.app", "custom_domain": true }],
  // wrangler は routes があると workers.dev を既定で止める。止めると古い URL を転送できないので明示する
  "workers_dev": true,
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // workers.dev から転送するため、静的アセットへのリクエストも Worker が先に受ける（ADR 0021）。
    // API でないリクエストは Worker が ASSETS に渡す（src/server/app.ts）
    "run_worker_first": true,
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nanaichi",
      // `pnpm cf d1 create nanaichi` で作成した本番のデータベース。
      "database_id": "0aa9e02f-791c-4090-b449-e8496dfe63db",
    },
  ],
  "durable_objects": {
    "bindings": [{ "name": "USER_DO", "class_name": "UserDO" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["UserDO"] }],
  // UserDO へのリクエストをユーザーごとに 10 秒で 100 回（平均 10 req/s）までにする（ADR 0018）。
  // namespace_id はアカウントの中で他の Worker の制限と重ならない番号なら何でもよい
  "ratelimits": [
    {
      "name": "USER_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 100, "period": 10 },
    },
    // ネイティブアプリのログイン（/api/native-auth/*）を、接続元の IP ごとに 60 秒で 10 回までにする（ADR 0029）。
    // 1回のログインは start・callback・token の 3 回
    {
      "name": "NATIVE_AUTH_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 10, "period": 60 },
    },
  ],
  // 判断モデル（Workers AI の clef-flash、ADR 0026）。AI バインディングはローカルでも本物の Workers AI に
  // つながる（ローカルの代用品がない）ので、開発サーバーとテストでは vite.config.ts / vitest.workers.config.ts が
  // 既定で切り離している
  "ai": { "binding": "AI" },
  "observability": { "enabled": true },
}
